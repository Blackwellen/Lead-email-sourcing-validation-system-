# Copy to .env and change EVERY secret. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
LEAD_SECRET_KEY=change-me-32+-random-characters-used-for-session-and-MFA-encryption
SITE_ADDRESS=localhost            # e.g. leads.example.com for automatic HTTPS
PUBLIC_URL=https://localhost
LEAD_CONTACT_EMAIL=               # shown in the crawler User-Agent so site owners can reach you
# First start only (when no users exist). Prefer: docker compose run --rm api python -m app.cli create-admin
LEAD_INITIAL_ADMIN_EMAIL=
LEAD_INITIAL_ADMIN_PASSWORD=
WORKER_CONCURRENCY=8
WORKER_MAX_RSS_MB=1200
WITH_BROWSER=0
# SMTP recipient diagnostics: OFF by default. Only enable for domains you own / have written permission to probe.
# Outbound port 25 is blocked on most clouds (incl. Oracle by default); check Settings -> System -> SMTP egress.
LEAD_SMTP_DIAGNOSTICS_ENABLED=false
LEAD_SMTP_HELO_HOST=
LEAD_SMTP_MAIL_FROM=
LEAD_SMTP_AUTHORISED_DOMAINS=
BACKUP_KEEP_DAYS=14
