# HTTPS reverse proxy. Set SITE_ADDRESS to your domain (automatic Let's Encrypt) or 'localhost' for a local self-signed cert.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	@api path /api/* /healthz /readyz
	handle @api {
		# refuse oversized bodies at the edge (uploads are capped at LEAD_MAX_UPLOAD_MB=50 by the API as well)
		request_body {
			max_size 60MB
		}
		reverse_proxy api:8000 {
			flush_interval -1   # needed for Server-Sent Events
		}
	}
	# /metrics is deliberately NOT exposed publicly.
	handle {
		reverse_proxy web:3000
	}
}
